{
  "name": "fleuron-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "check:links": "node scripts/check-links.mjs",
    "check:contrast": "playwright test tests/contrast.spec.ts",
    "check:no-external": "node scripts/check-no-external.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "check:browser": "playwright test tests/site-behavior.spec.ts",
    "verify:static": "npm run build && npm run check && npm run check:links && npm test && npm run check:no-external && npm run check:seo && npm run check:examples",
    "verify": "npm run verify:static && npm run check:contrast && npm run check:browser"
  },
  "dependencies": {
    "astro": "^7.2.9",
    "marked": "^18.0.11"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "csv-parse": "^6.1.0",
    "parse-srcset": "^1.0.2",
    "parse5": "^8.0.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "4.128.0"
  }
}
