---
import { siteFacts } from '../content/site-facts';
interface Props { class?: string; showLink?: boolean }
const { class: className = '', showLink = true } = Astro.props;
const local = ['Transcript files and full text', 'Quote fields and passage text', 'Original filenames and folder paths', 'Analytic and coding memo fields', 'Full project database and backups', 'Interview dates and diagnosis fields'];
const shared = ['Study and participant labels', 'Code names, hierarchy and colors', 'Definitions, criteria and examples', 'Coded spans: IDs and character offsets', 'Coder names and memberships', 'Content hashes and revision metadata'];
---
<figure class:list={['diagram-container', className]}>
  <svg viewBox="0 0 880 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="boundary-svg" role="img" aria-labelledby="boundary-diagram-title boundary-diagram-desc">
    <title id="boundary-diagram-title">Fleuron collaboration sync boundary</title>
    <desc id="boundary-diagram-desc">Collaboration sync excludes transcript text, quote fields and memo fields. It shares codebook text and coding metadata. Copied quotes in codebook fields sync as written. Exports and backups may leave the device through sharing or synced folders. Authentication is described below.</desc>
    <rect x="10" y="10" width="350" height="340" fill="var(--paper)" stroke="var(--rule)" stroke-width="3" />
    <rect x="520" y="10" width="350" height="340" fill="var(--paper)" stroke="var(--rule)" stroke-width="3" />
    <g font-family="var(--font-mono)" fill="var(--ink)" font-size="13" font-weight="600">
      <text x="30" y="43">THIS COMPUTER</text>
      <text x="540" y="43">OPTIONAL SYNC SERVICE</text>
    </g>
    <g font-family="var(--font-serif)" fill="var(--ink)" font-size="15">
      <text x="30" y="76">Excluded from collaboration sync</text>
      <text x="540" y="76">Shared when collaboration is enabled</text>
      {local.map((item, i) => <text x="30" y={120 + i * 33}>{item}</text>)}
      {shared.map((item, i) => <text x="540" y={120 + i * 33}>{item}</text>)}
    </g>
    <path d="M370 165 H504 M496 157 L504 165 L496 173" stroke="var(--rule)" stroke-width="3" />
    <g font-family="var(--font-mono)" fill="var(--ink)" font-size="11" text-anchor="middle">
      <text x="440" y="128">COLLABORATION</text><text x="440" y="144">SYNC</text>
      <text x="440" y="197">HTTPS / WSS</text><text x="440" y="217">Transport encryption</text>
    </g>
    <text x="30" y="326" font-family="var(--font-mono)" fill="var(--muted)" font-size="12">A SYNC BOUNDARY, NOT A SHARING LOCK</text>
    <text x="540" y="326" font-family="var(--font-mono)" fill="var(--muted)" font-size="12">AUTHOR SHARED TEXT DE-IDENTIFIED</text>
  </svg>
  <div class="boundary-mobile">
    <section><h3>Excluded from collaboration sync</h3><ul>{local.map(item => <li>{item}</li>)}</ul></section>
    <p class="sync-label">Collaboration sync · HTTPS / WSS</p>
    <section><h3>Shared when collaboration is enabled</h3><ul>{shared.map(item => <li>{item}</li>)}</ul></section>
  </div>
  <figcaption>
    <p>Codebook text syncs as written, including any copied quotes. Exports and backups can leave your device through sharing or synced folders.</p>
    <p>{siteFacts.credentials}</p>
    {showLink && <a href="/privacy/">Read the complete privacy and permissions disclosure →</a>}
  </figcaption>
</figure>
<style>
  .diagram-container { margin: 2rem 0; width: 100%; }
  .boundary-svg { display: block; width: 100%; height: auto; max-width: 880px; margin: 0 auto; }
  .boundary-mobile { display: none; }
  figcaption { margin-top: 1rem; font-size: 1rem; line-height: 1.6; }
  figcaption p { margin-bottom: 0.75rem; }
  figcaption a { color: var(--ink); text-decoration: underline; }
  @media (max-width: 760px) {
    .boundary-svg { display: none; }
    .boundary-mobile { display: block; }
    .boundary-mobile section { border: 2px solid var(--rule); padding: 1rem; }
    .boundary-mobile h3 { font-size: 1.125rem; margin-bottom: 0.75rem; }
    .boundary-mobile ul { padding-left: 1.25rem; line-height: 1.6; }
    .sync-label { font-family: var(--font-mono); font-size: 0.875rem; margin: 1rem 0; }
  }
</style>
