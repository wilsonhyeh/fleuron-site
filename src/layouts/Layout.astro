---
import '../styles/tokens.css';
import { pageFor } from '../content/site-pages';
import { fetchLatestRelease } from '../lib/release';

interface Props {
  title?: string;
  description?: string;
  releaseVersion?: string;
  releaseDate?: string;
  noindex?: boolean;
}

const {
  title = 'Fleuron',
  description = 'Fleuron is an offline-first qualitative analysis app for reflexive thematic analysis. Runs on your computer. Free forever for offline coding.',
  releaseVersion,
  releaseDate,
  noindex = false,
} = Astro.props;

// The release identity has one source: the GitHub release this build reads.
// Pages pass it down after fetching it; the layout resolves it here too, so a
// page that does not (the 404) still renders the real version. The fetch is
// cached for the build, and a failure stops the build rather than printing a
// stale version literal.
const latest = await fetchLatestRelease();
const version = releaseVersion ?? latest.version;
const date = releaseDate ?? latest.publishedAt;

const page = pageFor(Astro.url.pathname);
const pageTitle = page?.title ?? title;
const pageDescription = page?.description ?? description;
const canonicalURL = new URL(page?.path ?? Astro.url.pathname, Astro.site || 'https://fleuron.study');
const ogImageURL = new URL('/og.png', Astro.site || 'https://fleuron.study');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F7F3EA" />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {noindex && <meta name="robots" content="noindex" />}

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <meta name="twitter:url" content={canonicalURL} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="wordmark">
          <span class="wordmark-symbol" aria-hidden="true">■</span>
          <span class="wordmark-text">fleuron.study</span>
        </a>

        <nav class="nav-links" aria-label="Main navigation">
          <a href="/download/" class="nav-link">Download</a>
          <a href="/install/" class="nav-link">Install</a>
          <a href="/guides/" class="nav-link">Guides</a>
          <a href="/privacy/" class="nav-link">Privacy</a>
          <a href="/support/" class="nav-link">Support</a>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-meta">
          <span class="footer-version">Fleuron v{version} ({date})</span>
          <span class="footer-sep" aria-hidden="true">/</span>
          <a href="https://github.com/wilsonhyeh/fleuron" target="_blank" rel="noopener noreferrer">Source on GitHub</a>
          <span class="footer-sep" aria-hidden="true">/</span>
          <span>MIT License</span>
        </div>
        <div class="footer-credit">
          <span>Fleuron contributors</span>
        </div>
      </div>
    </footer>

    <!-- Cloudflare Web Analytics --><script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "062c64bf8aca454e81b3a4cc5eb0b831"}'></script><!-- End Cloudflare Web Analytics -->
  </body>
</html>

<style>
  .site-header {
    border-bottom: 3px solid var(--rule);
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-container {
    max-width: 68rem;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .wordmark:hover {
    text-decoration: none;
  }

  .wordmark-symbol {
    color: var(--ink);
    font-size: 0.875rem;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--ink);
    text-decoration: none;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
  }

  .nav-link:hover {
    border-bottom-color: var(--rule);
    text-decoration: none;
  }

  .main-content {
    max-width: 68rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    min-height: calc(100vh - 160px);
  }

  .site-footer {
    border-top: 3px solid var(--rule);
    background: var(--paper);
    padding: 2.5rem 1.5rem;
  }

  .footer-container {
    max-width: 68rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-sep {
    color: var(--muted);
  }

  .footer-meta a {
    color: var(--ink);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .header-container {
      flex-wrap: wrap;
    }
    .nav-links {
      order: 3;
      width: 100%;
      gap: 0.75rem;
      padding-top: 0.5rem;
      border-top: 1px solid var(--rule);
    }
    .main-content {
      padding: 2rem 1rem 3rem;
    }
  }
</style>
