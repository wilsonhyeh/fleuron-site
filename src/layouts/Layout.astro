---
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  releaseVersion?: string;
  releaseDate?: string;
}

const {
  title,
  description = 'Fleuron is an offline-first qualitative analysis app for reflexive thematic analysis. Runs on your computer. Free forever for offline coding.',
  releaseVersion = '2.1.0',
  releaseDate = '2026-08-29',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://fleuron.study');
const ogImageURL = new URL('/og.png', Astro.site || 'https://fleuron.study');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title === 'Fleuron' ? title : `${title} — Fleuron`}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title === 'Fleuron' ? title : `${title} — Fleuron`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title === 'Fleuron' ? title : `${title} — Fleuron`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="wordmark">
          <span class="wordmark-symbol" aria-hidden="true">■</span>
          <span class="wordmark-text">fleuron.study</span>
        </a>

        <nav class="nav-links" aria-label="Main navigation">
          <a href="/download" class="nav-link">Download</a>
          <a href="/install" class="nav-link">Install</a>
          <a href="/privacy" class="nav-link">Privacy</a>
          <a href="/support" class="nav-link">Support</a>
        </nav>

        <button
          type="button"
          id="theme-toggle"
          class="theme-toggle-btn"
          aria-label="Toggle dark mode"
          title="Toggle theme"
        >
          <span class="theme-toggle-label" id="theme-toggle-text">Theme</span>
        </button>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-meta">
          <span class="footer-version">Fleuron v{releaseVersion} ({releaseDate})</span>
          <span class="footer-sep" aria-hidden="true">/</span>
          <a href="https://github.com/wilson-taiwan/fleuron" target="_blank" rel="noopener noreferrer">Source on GitHub</a>
          <span class="footer-sep" aria-hidden="true">/</span>
          <span>MIT License</span>
        </div>
        <div class="footer-credit">
          <span>Fleuron contributors</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function() {
        var btn = document.getElementById('theme-toggle');
        var text = document.getElementById('theme-toggle-text');
        
        function updateButtonLabel() {
          if (!text) return;
          var currentTheme = document.documentElement.dataset.theme;
          var isDark = currentTheme === 'dark' || (!currentTheme && window.matchMedia('(prefers-color-scheme: dark)').matches);
          text.textContent = isDark ? 'Light' : 'Dark';
        }

        updateButtonLabel();

        if (btn) {
          btn.addEventListener('click', function() {
            try {
              var current = document.documentElement.dataset.theme;
              var isDark = current === 'dark' || (!current && window.matchMedia('(prefers-color-scheme: dark)').matches);
              var next = isDark ? 'light' : 'dark';
              document.documentElement.dataset.theme = next;
              localStorage.setItem('theme', next);
              updateButtonLabel();
            } catch (e) {}
          });
        }
      })();
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 3px solid var(--rule);
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-container {
    max-width: 68rem;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .wordmark:hover {
    text-decoration: none;
  }

  .wordmark-symbol {
    color: var(--ink);
    font-size: 0.875rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--ink);
    text-decoration: none;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
  }

  .nav-link:hover {
    border-bottom-color: var(--rule);
    text-decoration: none;
  }

  .theme-toggle-btn {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    background: var(--paper);
    color: var(--ink);
    border: 2px solid var(--rule);
    padding: 0.375rem 0.75rem;
    cursor: pointer;
    box-shadow: 2px 2px 0 var(--rule);
  }

  .theme-toggle-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 0 0 0 var(--rule);
  }

  .main-content {
    max-width: 68rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    min-height: calc(100vh - 160px);
  }

  .site-footer {
    border-top: 3px solid var(--rule);
    background: var(--paper);
    padding: 2.5rem 1.5rem;
  }

  .footer-container {
    max-width: 68rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-sep {
    color: var(--muted);
  }

  .footer-meta a {
    color: var(--ink);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .header-container {
      flex-wrap: wrap;
    }
    .nav-links {
      order: 3;
      width: 100%;
      gap: 1rem;
      padding-top: 0.5rem;
      border-top: 1px solid var(--rule);
    }
    .main-content {
      padding: 2rem 1rem 3rem;
    }
  }
</style>
