---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Frame from '../components/Frame.astro';
import Rule from '../components/Rule.astro';
import WindowChrome from '../components/WindowChrome.astro';
import BoundaryDiagram from '../components/BoundaryDiagram.astro';
import { Image } from 'astro:assets';
import transcriptScreen from '../assets/screens/transcript-coding.webp';
import savedLocationScreen from '../assets/screens/saved-location.webp';
import exportScreen from '../assets/screens/export-dialog.webp';
import { fetchLatestRelease } from '../lib/release';
import { siteFacts } from '../content/site-facts';
import StructuredData from '../components/StructuredData.astro';

const release = await fetchLatestRelease();
---

<Layout
  title="Fleuron"
  description="Offline-first qualitative analysis software for reflexive thematic analysis. Runs on your computer. Free forever for offline coding."
  releaseVersion={release.version}
  releaseDate={release.publishedAt}
>
  <StructuredData data={{ '@context': 'https://schema.org', '@graph': [
    { '@type': 'WebSite', '@id': `${siteFacts.url}#website`, name: 'Fleuron', url: siteFacts.url },
    { '@type': 'SoftwareApplication', '@id': `${siteFacts.url}#software`, name: 'Fleuron', url: siteFacts.url,
      applicationCategory: 'EducationApplication', operatingSystem: ['macOS 14+', 'Windows 11 x64'],
      softwareVersion: release.version, downloadUrl: `${siteFacts.url}download/`, license: siteFacts.sources.license,
      description: siteFacts.lead, offers: { '@type': 'Offer', name: 'Free offline coding', price: 0, priceCurrency: 'USD', url: `${siteFacts.url}download/` } }
  ] }} />
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <h1 class="hero-title">Free qualitative analysis software that runs on your computer.</h1>
      <p class="hero-lead">
        {siteFacts.lead}
      </p>
      <p class="offer-scope">{siteFacts.pricingShort}</p>
      <div class="hero-cta">
        <div class="cta-buttons" id="download-cta-group">
          <!-- Server-rendered default: both buttons visible -->
          <Button
            href={release.mac.url}
            variant="primary"
            class="download-btn btn-mac"
            id="hero-mac-btn"
          >
            Download for macOS <span class="btn-meta">({release.mac.formattedSize})</span>
          </Button>

          <Button
            href={release.win.url}
            variant="primary"
            class="download-btn btn-win"
            id="hero-win-btn"
          >
            Download for Windows <span class="btn-meta">({release.win.formattedSize})</span>
          </Button>
        </div>

        <div class="hero-meta">
          <span class="mono-meta">Version {release.version} ({release.publishedAt})</span>
          <span class="meta-sep">·</span>
          <a href="/download/">All downloads & checksums</a>
          <span class="meta-sep">·</span>
          <a href="/install/">Install guide</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Script for smart platform detection (progressive enhancement) -->
  <script is:inline>
    (function() {
      try {
        var ua = navigator.userAgent || '';
        var isMac = /Macintosh|Mac OS X/i.test(ua);
        var isWin = /Windows/i.test(ua);
        var macBtn = document.getElementById('hero-mac-btn');
        var winBtn = document.getElementById('hero-win-btn');

        if (isMac && macBtn && winBtn) {
          winBtn.classList.remove('btn-primary');
          winBtn.classList.add('btn-secondary');
        } else if (isWin && macBtn && winBtn) {
          macBtn.classList.remove('btn-primary');
          macBtn.classList.add('btn-secondary');
          // Reorder so Windows is first
          var parent = document.getElementById('download-cta-group');
          if (parent) parent.insertBefore(winBtn, macBtn);
        }
      } catch (e) {}
    })();
  </script>

  <Rule />

  <!-- Main Interface Screenshot -->
  <section class="section-screenshot">
    <WindowChrome title={`Fleuron v${release.version} — Qualitative Workspace`}>
      <Image
        src={transcriptScreen}
        alt="Fleuron transcript view showing a community-garden interview with a coded passage, two code labels and a Saved status in the toolbar"
        width={1440}
        height={900}
        loading="eager"
      />
    </WindowChrome>
    <p class="screenshot-caption">
      Synthetic community-garden interview in the demo workspace. Coded spans, code labels and the save status.
    </p>
  </section>

  <Rule />

  <!-- Key Features -->
  <section class="section-features">
    <h2 class="section-title">Designed for reflexive qualitative analysis</h2>
    <div class="features-grid">
      <Frame class="feature-card">
        <h3 class="feature-title">Span and whole-turn coding</h3>
        <p class="feature-text">
          Code word spans or whole speaker turns, with the coding bubble and keyboard shortcuts.
        </p>
      </Frame>

      <Frame class="feature-card">
        <h3 class="feature-title">Living codebook</h3>
        <p class="feature-text">
          Build an evolving code hierarchy with optional definitions and examples.
        </p>
      </Frame>

      <Frame class="feature-card">
        <h3 class="feature-title">Saving you can see</h3>
        <p class="feature-text">
          Notes save after a typing pause; the toolbar shows Saved, Saving… or unsaved notes.
        </p>
      </Frame>

      <Frame class="feature-card">
        <h3 class="feature-title">Reflexive memos</h3>
        <p class="feature-text">
          Write analytic and methodological memos beside your transcripts.
        </p>
      </Frame>

      <Frame class="feature-card">
        <h3 class="feature-title">Your study folder, visible</h3>
        <p class="feature-text">
          Click Saved to see the study folder, open it, or copy its path.
        </p>
      </Frame>

      <Frame class="feature-card">
        <h3 class="feature-title">Import and export</h3>
        <p class="feature-text">
          Import .txt, .md, .docx, .vtt, .srt, .csv and .tsv; export HTML, PDF and CSV.
        </p>
      </Frame>
    </div>
  </section>

  <Rule />

  <!-- Privacy Boundary -->
  <section class="section-boundary">
    <h2 class="section-title">Where your research data lives</h2>
    <p class="section-lead">
      {siteFacts.privacy}
    </p>
    <BoundaryDiagram />
  </section>

  <Rule />

  <!-- Secondary Screenshots -->
  <section class="section-dual-screens">
    <div class="screens-grid">
      <div>
        <WindowChrome title="Fleuron — Where your work is saved">
          <Image
            src={savedLocationScreen}
            alt="Fleuron save status popover naming the study folder, with Show in Finder and Copy path buttons"
            width={1440}
            height={900}
          />
        </WindowChrome>
        <p class="screenshot-caption">Saved names the folder that holds the study, and opens it.</p>
      </div>

      <div>
        <WindowChrome title="Fleuron — Export Dialog">
          <Image
            src={exportScreen}
            alt="Fleuron export dialog with Reflexive Thematic Analysis preset selected"
            width={1440}
            height={900}
          />
        </WindowChrome>
        <p class="screenshot-caption">Methodology presets for Reflexive Thematic Analysis and Content Analysis.</p>
      </div>
    </div>
  </section>

  <Rule />

  <!-- What it costs -->
  <section class="section-pricing">
    <h2 class="section-title">What it costs</h2>
    <div class="pricing-card">
      <p class="pricing-text">
        {siteFacts.pricing}
      </p>
    </div>
  </section>

  <Rule />

  <!-- Honest Limits -->
  <section class="section-limits">
    <h2 class="section-title">Honest limits</h2>
    <div class="limits-grid">
      <div class="limit-item">
        <h3 class="limit-title">Local only</h3>
        <p class="limit-text">
          Fleuron is a single-user desktop application: no accounts, no cloud sync and no shared workspace. A study is a folder on your computer.
        </p>
      </div>

      <div class="limit-item">
        <h3 class="limit-title">Unsigned installers</h3>
        <p class="limit-text">
          {siteFacts.signing} <a href="/install/">Expected warnings</a>.
        </p>
      </div>

      <div class="limit-item">
        <h3 class="limit-title">Operating systems</h3>
        <p class="limit-text">
          {siteFacts.platforms}
        </p>
      </div>
    </div>
  </section>
  <Rule />
  <section class="section-learning">
    <h2 class="section-title">Try a small analysis</h2>
    <p class="section-lead">Start with the <a href="/guides/code-interview-transcripts/">transcript-coding tutorial</a>, then try the <a href="/guides/reflexive-thematic-analysis/">reflexive thematic analysis workflow</a> or <a href="/compare/free-qualitative-analysis-software/">compare Fleuron with Taguette and QualCoder</a>.</p>
  </section>
  <Rule />
  <section class="faq" aria-labelledby="faq-title">
    <h2 id="faq-title" class="section-title">Common questions</h2>
    <details><summary>Can I code without an internet connection?</summary><p>Yes. Coding never touches the network; Fleuron checks GitHub only for updates. <a href="/privacy/">Data disclosure</a>.</p></details>
    <details><summary>Can I work with a team?</summary><p>Not inside Fleuron: it is a single-user app, and studies live in a local folder. Share an export to hand work over.</p></details>
    <details><summary>Does Fleuron replace methodological judgment?</summary><p>No. It organizes codes and memos; it does not validate interpretations or certify compliance. <a href="/guides/reflexive-thematic-analysis/">Workflow guide</a>.</p></details>
  </section>
</Layout>

<style>
  .offer-scope { max-width: var(--measure); margin-bottom: 1.5rem; line-height: 1.6; font-family: var(--font-mono); font-size: 0.9375rem; }
  .faq details { border-bottom: 1px solid var(--rule); padding: 1rem 0; }
  .faq summary { cursor: pointer; font-weight: 600; font-size: 1.125rem; }
  .faq p { margin: 0.75rem 0; max-width: var(--measure); line-height: 1.6; }

  .hero-section {
    padding: 1.5rem 0 2rem;
  }

  .hero-title {
    font-size: 2.75rem;
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    max-width: 24ch;
  }

  .hero-lead {
    font-size: 1.375rem;
    line-height: 1.55;
    color: var(--ink);
    max-width: var(--measure);
    margin-bottom: 2.25rem;
  }

  .hero-cta {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .btn-meta {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 400;
    opacity: 0.85;
    margin-left: 0.35rem;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .mono-meta {
    color: var(--muted);
  }

  .meta-sep {
    color: var(--muted);
  }

  .hero-meta a {
    color: var(--ink);
    text-decoration: underline;
  }

  .section-screenshot {
    margin: 1rem 0;
  }

  .screenshot-caption {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
    margin-top: 0.75rem;
  }

  .section-title {
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
  }

  .section-lead {
    font-size: 1.25rem;
    line-height: 1.5;
    max-width: var(--measure);
    margin-bottom: 1.5rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .feature-title {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .feature-text {
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--ink);
  }

  .screens-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 2rem;
  }

  .pricing-card {
    border: 2px solid var(--rule);
    box-shadow: 4px 4px 0 var(--rule);
    background: var(--paper);
    padding: 1.75rem 2rem;
    max-width: var(--measure);
  }

  .pricing-text {
    font-size: 1.25rem;
    line-height: 1.55;
  }

  .limits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.75rem;
  }

  .limit-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .limit-title {
    font-size: 1.125rem;
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .limit-text {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.125rem;
    }
    .hero-lead {
      font-size: 1.1875rem;
    }
  }
</style>
