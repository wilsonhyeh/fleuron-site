---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Frame from '../components/Frame.astro';
import Rule from '../components/Rule.astro';
import Callout from '../components/Callout.astro';
import { fetchLatestRelease } from '../lib/release';

const release = await fetchLatestRelease();
---

<Layout
  title="Download"
  description={`Download Fleuron v${release.version} for macOS and Windows. Free forever for offline qualitative coding.`}
  releaseVersion={release.version}
  releaseDate={release.publishedAt}
>
  <div class="download-page">
    <header class="page-header">
      <h1 class="page-title">Download Fleuron</h1>
      <p class="page-lead">
        Offline-first reflexive thematic analysis for desktop. Choose the installer for your operating system.
      </p>
      <div class="release-badge">
        <span class="mono-meta">Current release: v{release.version}</span>
        <span class="meta-sep">/</span>
        <span class="mono-meta">Published: {release.publishedAt}</span>
      </div>
    </header>

    <Rule />

    <!-- Download Options Grid -->
    <section class="downloads-section">
      <div class="downloads-grid">
        <!-- macOS Card -->
        <Frame class="platform-card" thick>
          <div class="card-header">
            <h2 class="platform-name">macOS</h2>
            <span class="platform-arch">Universal (Apple Silicon & Intel)</span>
          </div>

          <div class="file-details">
            <div class="detail-row">
              <span class="detail-label">Filename</span>
              <code class="detail-value">{release.mac.name}</code>
            </div>
            <div class="detail-row">
              <span class="detail-label">File size</span>
              <span class="detail-value">{release.mac.formattedSize}</span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Compatibility</span>
              <span class="detail-value">macOS 12 Monterey or later</span>
            </div>
          </div>

          <div class="card-actions">
            <Button
              href={release.mac.url}
              variant="primary"
              class="platform-download-btn"
            >
              Download for macOS
            </Button>
          </div>
        </Frame>

        <!-- Windows Card -->
        <Frame class="platform-card" thick>
          <div class="card-header">
            <h2 class="platform-name">Windows</h2>
            <span class="platform-arch">64-bit (x64)</span>
          </div>

          <div class="file-details">
            <div class="detail-row">
              <span class="detail-label">Filename</span>
              <code class="detail-value">{release.win.name}</code>
            </div>
            <div class="detail-row">
              <span class="detail-label">File size</span>
              <span class="detail-value">{release.win.formattedSize}</span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Compatibility</span>
              <span class="detail-value">Windows 10 / Windows 11 (64-bit)</span>
            </div>
          </div>

          <div class="card-actions">
            <Button
              href={release.win.url}
              variant="primary"
              class="platform-download-btn"
            >
              Download for Windows
            </Button>
          </div>
        </Frame>
      </div>
    </section>

    <!-- Unsigned Build Notice -->
    <Callout title="Unsigned build notice">
      <p>
        Fleuron is independent open-source software and does not carry commercial Apple Developer or Microsoft Authenticode publisher certificates. Your operating system will display an unidentified developer warning on first launch.
      </p>
      <p>
        Before launching, review the <a href="/install">Step-by-step Installation Guide</a> to confirm the exact expected warning and know when to stop if an unexpected alert appears.
      </p>
    </Callout>

    <Rule />

    <!-- Checksums and Verification -->
    <section class="verification-section">
      <h2 class="section-title">Verification and integrity</h2>
      <p class="section-text">
        Every release asset is accompanied by cryptographic SHA-256 digests and GitHub artifact attestations. You can verify downloaded binaries against published checksums:
      </p>

      <div class="checksum-links">
        <a href={release.checksumsUrl} target="_blank" rel="noopener noreferrer" class="checksum-btn">
          View SHA256SUMS.txt for v{release.version} →
        </a>
        <a href={release.releaseUrl} target="_blank" rel="noopener noreferrer" class="checksum-btn">
          View GitHub Release v{release.version} →
        </a>
      </div>

      <div class="hosting-note">
        <span class="hosting-icon">ℹ</span>
        <p>
          Download buttons link directly to release assets hosted on GitHub's release CDN (<code class="mono-inline">github.com/wilson-taiwan/fleuron/releases</code>). This website never hosts installer binaries directly.
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .download-page {
    max-width: var(--measure);
    margin: 0 auto;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .page-lead {
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--ink);
    margin-bottom: 1.25rem;
  }

  .release-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .meta-sep {
    color: var(--muted);
  }

  .downloads-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin: 2rem 0;
  }

  .platform-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .card-header {
    border-bottom: 2px solid var(--rule);
    padding-bottom: 0.75rem;
  }

  .platform-name {
    font-size: 1.625rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .platform-arch {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .file-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.9375rem;
  }

  .detail-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .detail-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .detail-value {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    word-break: break-all;
  }

  .card-actions {
    margin-top: 0.5rem;
  }

  .platform-download-btn {
    width: 100%;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .section-text {
    font-size: 1.0625rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .checksum-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .checksum-btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--ink);
    border: 2px solid var(--rule);
    padding: 0.625rem 1rem;
    text-decoration: none;
    box-shadow: 2px 2px 0 var(--rule);
    background: var(--paper);
  }

  .checksum-btn:hover {
    text-decoration: none;
  }

  .checksum-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 0 0 0 var(--rule);
  }

  .hosting-note {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    border: 1px solid var(--rule);
    padding: 1rem;
    background: var(--paper);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .hosting-icon {
    font-family: var(--font-mono);
    font-weight: bold;
    color: var(--ink);
  }

  .mono-inline {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink);
  }
</style>
