---
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';
import Rule from '../components/Rule.astro';
import BoundaryDiagram from '../components/BoundaryDiagram.astro';
import Callout from '../components/Callout.astro';
import { fetchLatestRelease } from '../lib/release';
import { siteFacts } from '../content/site-facts';

const release = await fetchLatestRelease();
---

<Layout
  title="Privacy & Data Boundary"
  releaseVersion={release.version}
  releaseDate={release.publishedAt}
>
  <div class="privacy-page">
    <header class="page-header">
      <h1 class="page-title">Privacy & Data Boundary</h1>
      <p class="page-lead">
        Built for research where transcripts and quotes stay in your control. What the app stores, what it contacts online, and how this site is hosted.
      </p>
    </header>

    <Rule />

    <!-- Part 1: The Application -->
    <section class="section-app-privacy">
      <h2 class="section-title">1. The app</h2>
      <p class="section-text">
        {siteFacts.localOnly}
      </p>

      <div class="diagram-wide">
        <BoundaryDiagram showLink={false} />
      </div>

      <p class="section-text">
        Fleuron is a single-user desktop app: a study is a folder you choose, and exports or backups leave the device only when you share them or keep the folder in a synced location.
      </p>

      <p class="section-text">{siteFacts.network}</p>

      <Callout title="Research caveats">
        <ul class="caveat-list">
          <li>
            <strong>De-identification is yours:</strong> Fleuron does not de-identify your material. Transcripts, code names, definitions and memos are stored and exported as written, so keep identifying information out of anything you share.
          </li>
          <li>
            <strong>Method vs compliance:</strong> Fleuron can support a research protocol; it does not certify compliance of any kind.
          </li>
        </ul>
      </Callout>

      <div class="doc-links">
        <a href="https://github.com/wilsonhyeh/fleuron/blob/main/docs/PRIVACY-AND-PERMISSIONS.md" target="_blank" rel="noopener noreferrer" class="doc-link">
          Privacy and permissions doc →
        </a>
        <a href="https://github.com/wilsonhyeh/fleuron/blob/main/docs/IT-DEPLOYMENT.md" target="_blank" rel="noopener noreferrer" class="doc-link">
          IT deployment doc →
        </a>
      </div>
    </section>

    <Rule />

    <!-- Part 2: The Website -->
    <section class="section-web-privacy">
      <h2 class="section-title">2. This site</h2>
      <p class="section-text">
        {siteFacts.website}
      </p>

      <Frame class="guarantee-card">
        <ul class="guarantee-list">
          <li><strong>Nothing stored in your browser:</strong> no cookies, no local storage, no theme setting — the site is light-only.</li>
          <li><strong>No forms or inputs:</strong> no emails, names, newsletters or visitor submissions are collected.</li>
          <li><strong>Only one external asset:</strong> the analytics beacon (<span class="mono-code">static.cloudflareinsights.com</span>). <a href={siteFacts.sources.nel}>Cloudflare’s error reporting</a>.</li>
          <li><strong>Scope of the check:</strong> the asset-reference check scans generated HTML and CSS, not every runtime request.</li>
        </ul>
      </Frame>
    </section>
  </div>
</Layout>

<style>
  .privacy-page {
    max-width: var(--measure);
    margin: 0 auto;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .page-lead {
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--ink);
    margin-bottom: 1.25rem;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .section-text {
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  /* The diagram is drawn at 880px; let it use that width instead of being
     squeezed into the 68ch text measure, where its labels shrink too far. */
  @media (min-width: 1000px) {
    .diagram-wide {
      width: 880px;
      margin-inline: calc(50% - 440px);
    }
  }

  .caveat-list {
    margin: 0.5rem 0 0.5rem 1.25rem;
    font-size: 1rem;
    line-height: 1.5;
  }

  .caveat-list li {
    margin-bottom: 0.5rem;
  }

  .caveat-list li:last-child {
    margin-bottom: 0;
  }

  .doc-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .doc-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--ink);
    text-decoration: underline;
  }

  .guarantee-card {
    margin: 1.5rem 0;
  }

  .guarantee-list {
    margin: 0.5rem 0 0.5rem 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .guarantee-list li {
    margin-bottom: 0.75rem;
  }

  .guarantee-list li:last-child {
    margin-bottom: 0;
  }

  .mono-code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--paper);
    padding: 0.1em 0.3em;
    border: 1px solid var(--rule);
  }
</style>
